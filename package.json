{
  "name": "svelthon",
  "version": "1.0.0",
  "description": "Svelte components written in Python, compiled by Brython at build time",
  "author": "Florent Gallaire <fgallaire@gmail.com>",
  "license": "MIT",
  "keywords": [
    "svelte",
    "python",
    "brython",
    "vite-plugin",
    "svelte-preprocessor",
    "compiler"
  ],
  "type": "module",
  "main": "./src/lib/svelthon.js",
  "exports": {
    ".": "./src/lib/svelthon.js",
    "./runtime": "./src/lib/runtime.js",
    "./compile": "./src/lib/compile.cjs",
    "./markup": "./src/lib/markup.js",
    "./package.json": "./package.json"
  },
  "files": [
    "BRYTHON.md",
    "DJANGO_FLASK.md",
    "src/lib",
    "vendor"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "bash scripts/browser-check.sh",
    "test:hmr": "bash scripts/hmr-check.sh",
    "test:all": "npm run test && npm run test:browser && npm run test:hmr",
    "bench": "bash scripts/bench.sh"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.9",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
