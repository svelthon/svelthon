{
  "name": "svelthon",
  "version": "1.0.0",
  "description": "Svelte components in Python",
  "author": "Florent Gallaire <fgallaire@gmail.com>",
  "license": "MIT",
  "homepage": "https://svelthon.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svelthon/svelthon.git"
  },
  "bugs": {
    "url": "https://github.com/svelthon/svelthon/issues"
  },
  "keywords": [
    "svelte",
    "python",
    "brython",
    "vite-plugin",
    "svelte-preprocessor",
    "compiler"
  ],
  "type": "module",
  "main": "./src/lib/svelthon.js",
  "exports": {
    ".": "./src/lib/svelthon.js",
    "./bridge": "./src/lib/bridge.js",
    "./compile": "./src/lib/compile.js",
    "./markup": "./src/lib/markup.js",
    "./package.json": "./package.json"
  },
  "files": [
    "BRYTHON.md",
    "DJANGO_FLASK.md",
    "notes",
    "src/lib"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "svelte": "^5.56.0"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "bash scripts/browser-check.sh",
    "test:hmr": "bash scripts/hmr-check.sh",
    "test:quiet": "node scripts/quiet-check.mjs",
    "test:kit": "bash scripts/kit-check.sh",
    "test:all": "npm run test && npm run test:quiet && npm run test:browser && npm run test:hmr && npm run test:kit",
    "bench": "bash scripts/bench.sh"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "6.0.0-next.10",
    "@sveltejs/kit": "3.0.0-next.23",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.9",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bryntime": "file:../bryntime"
  }
}
